{
  "name": "pulse-status",
  "version": "1.0.19",
  "private": true,
  "type": "module",
  "description": "Pulse â€” a clearer picture of the internet's health",
  "author": "Pulse",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "build:deploy": "npm run build:web && node scripts/prepare-downloads.mjs",
    "screenshots": "node scripts/capture-marketing.mjs",
    "qa:responsive": "node scripts/check-responsive.mjs",
    "qa:ui": "node scripts/ui-audit.mjs",
    "qa:screens": "node scripts/capture-screens.mjs",
    "build:portable": "npm run build:windows && npm run build:android",
    "sync:metadata": "node scripts/update-release-assets.mjs",
    "sync:public-downloads": "node scripts/sync-public-downloads.mjs",
    "build:all-downloads": "npm run build:portable && npm run verify:native && npm run sync:metadata && npm run sync:public-downloads && npm run build:deploy",
    "watch:all-downloads": "node scripts/watch-and-sync-downloads.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "desktop": "npm run build && electron .",
    "build:windows": "npm run build && electron-builder --win portable",
    "android:sync": "node scripts/generate-native-catalog.mjs && npm run build && cap sync android",
    "build:android": "npm run android:sync && node scripts/build-android.mjs",
    "android:open": "cap open android",
    "verify:native": "node scripts/verify-native-builds.mjs"
  },
  "build": {
    "appId": "app.pulse.status",
    "productName": "Pulse",
    "directories": {
      "output": "releases"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "server/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "desktop/icon.ico"
    },
    "portable": {
      "artifactName": "Pulse-${version}-Windows.exe"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/share": "^8.0.1",
    "@fontsource/instrument-serif": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "d3-geo": "^3.1.1",
    "fast-xml-parser": "^5.11.1",
    "gsap": "3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "simple-icons": "^16.31.0",
    "vite": "^8.3.0"
  }
}
