<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview only. A collection widget's real layout previews empty
     because no adapter is bound, so this stand-in shows representative rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_pulse_notification_logo" android:contentDescription="@string/widget_brand" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_eyebrow" android:textColor="#A3A3A3" android:textSize="10sp" android:letterSpacing="0.1" android:layout_marginStart="8dp" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/widget_preview_summary" android:textSize="17sp" android:textStyle="bold" android:textColor="#FAFAFA" android:maxLines="1" android:ellipsize="end" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_preview_subtitle" android:textSize="10sp" android:textColor="#A3A3A3" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="7dp" android:paddingBottom="7dp">
            <ImageView android:layout_width="17dp" android:layout_height="17dp" android:src="@drawable/ic_provider_aws" android:tint="#FF8989" android:contentDescription="@null" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="AWS" android:textSize="12sp" android:textColor="#FAFAFA" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="9dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_preview_major" android:textSize="10sp" android:textColor="#FF8989" android:layout_marginStart="10dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="7dp" android:paddingBottom="7dp">
            <ImageView android:layout_width="17dp" android:layout_height="17dp" android:src="@drawable/ic_provider_openai" android:tint="#EBC06C" android:contentDescription="@null" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="OpenAI" android:textSize="12sp" android:textColor="#FAFAFA" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="9dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_preview_degraded" android:textSize="10sp" android:textColor="#EBC06C" android:layout_marginStart="10dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="7dp" android:paddingBottom="7dp">
            <ImageView android:layout_width="17dp" android:layout_height="17dp" android:src="@drawable/ic_provider_docker" android:tint="#2496ED" android:contentDescription="@null" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Docker" android:textSize="12sp" android:textColor="#FAFAFA" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="9dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_preview_operational" android:textSize="10sp" android:textColor="#93D3AD" android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="4dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_preview_stamp" android:textSize="9sp" android:textColor="#A3A3A3" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:layout_width="44dp" android:layout_height="28dp" android:text="↻" android:gravity="center" android:textColor="#FAFAFA" android:textSize="22sp" android:contentDescription="@string/widget_refresh_action"/>
    </LinearLayout>
</LinearLayout>
