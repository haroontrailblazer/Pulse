<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="7dp" android:paddingBottom="7dp">
    <ImageView android:id="@+id/row_icon" android:layout_width="17dp" android:layout_height="17dp" android:src="@drawable/ic_pulse_notification_logo" android:contentDescription="@null" />
    <TextView android:id="@+id/row_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#FAFAFA" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="9dp" />
    <TextView android:id="@+id/row_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#A3A3A3" android:layout_marginStart="10dp" />
</LinearLayout>
