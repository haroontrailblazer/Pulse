<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="14dp">
    <LinearLayout android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:contentDescription="@string/widget_open_action">
        <LinearLayout android:id="@+id/widget_eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_pulse_notification_logo" android:contentDescription="@string/widget_brand" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_eyebrow" android:textColor="#A3A3A3" android:textSize="10sp" android:letterSpacing="0.1" android:layout_marginStart="8dp" />
        </LinearLayout>
        <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/widget_empty_summary" android:textSize="17sp" android:textStyle="bold" android:textColor="#FAFAFA" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_empty_subtitle" android:textSize="10sp" android:textColor="#A3A3A3" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp">
        <ListView android:id="@+id/widget_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:dividerHeight="0dp" android:scrollbars="none" />
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:text="@string/widget_empty_list" android:textSize="12sp" android:textColor="#A3A3A3" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="4dp">
        <TextView android:id="@+id/widget_time" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_awaiting" android:textSize="9sp" android:textColor="#A3A3A3" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_refresh" android:layout_width="44dp" android:layout_height="28dp" android:text="↻" android:gravity="center" android:textColor="#FAFAFA" android:textSize="22sp" android:contentDescription="@string/widget_refresh_action"/>
    </LinearLayout>
</LinearLayout>
